{
  "mcpServers": {
    "rocky-mem": {
      "type": "stdio",
      "command": "${workspaceFolder}/bin/rockymem",
      "args": [
        "--dsn",
        "sqlite://${workspaceFolder}/.local/rocky-mem.db",
        "mcp"
      ],
      "env": {
        "ROCKYMEM_HOME": "${workspaceFolder}/.local"
      }
    }
  }
}
